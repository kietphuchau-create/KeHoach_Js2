# ==============================================================================
# Git Ignore - DuAnChinhThuc (MedSched Smart Healthcare System)
# ==============================================================================

# --- Node & Next.js (Frontend) ---
**/node_modules/
**/.next/
# CHU Y: KHONG dung "**/out/" o day. Kien truc hexagonal cua backend co cac goi
# Java ten "out" (core/port/out, app/adapter/out) - mau "**/out/" se am tham bo
# qua toan bo file .java trong do, khien "git add" khong bao loi nhung code khong
# bao gio len repo va build hong o may nguoi khac. Chi chan dung thu muc build
# cua Next.js:
Source_code/frontend/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.tsbuildinfo

# --- Java & Gradle (Backend) ---
.gradle/
**/build/
**/bin/
!src/**/build/
*.class
*.jar
# Ngoai le: Gradle wrapper jar PHAI duoc commit, neu khong ai clone repo ve
# cung khong chay duoc ./gradlew (loi "Unable to access jarfile").
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# --- IDEs & Editors ---
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*~
.classpath
.project
.settings/

# --- Operating System Files ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# --- Tài liệu học tập & Slide lý thuyết (Chỉ lưu máy cục bộ, không đẩy lên Git) ---
Ly_Thuyet/
