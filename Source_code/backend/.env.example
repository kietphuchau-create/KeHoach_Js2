# Sao chép tệp này thành .env và điền API key thật. Không commit tệp .env.
OPENROUTER_API_KEY=your_real_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MedSched AI

# Gemini là nhà cung cấp dự phòng tùy chọn.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Email/Brevo. Không điền secret vào application.yml.
MAIL_USERNAME=
MAIL_PASSWORD=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MedSched Smart Healthcare

# PayOS. Tạo/luân chuyển khóa trong PayOS Dashboard và chỉ lưu tại môi trường chạy.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# JWT và chống spam AI.
JWT_SECRET=
AI_MAX_REQUESTS_PER_WINDOW=20
AI_WINDOW_SECONDS=60
AI_DUPLICATE_SECONDS=5
AI_MAX_MESSAGE_CHARS=2000
AI_MAX_IDENTITIES=10000
AI_CLEANUP_MILLIS=60000
