{
  "info": {
    "_postman_id": "medsched-api-collection-2026",
    "name": "MedSched - Smart Healthcare API Collection",
    "description": "Bộ sưu tập kiểm thử RESTful API đầy đủ của hệ thống MedSched Spring Boot 3.\nChuẩn thiết kế theo chỉ đạo của Thầy Trương Thanh Bình (14/09/2026).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Đăng Nhập (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@medsched.vn\",\n  \"password\": \"Medsched@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Đăng Ký Bệnh Nhân (Register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn Bệnh Nhân\",\n  \"email\": \"patient_test@gmail.com\",\n  \"phone\": \"0988112233\",\n  \"password\": \"Medsched@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Profile (/me)",
      "item": [
        {
          "name": "Lấy thông tin cá nhân (Get Profile)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Cập nhật thông tin cá nhân (Update Profile)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn A (Đã cập nhật)\",\n  \"phone\": \"0987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Đổi Mật Khẩu (Change Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Medsched@123\",\n  \"newPassword\": \"NewPassword@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/me/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["me", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin Management",
      "item": [
        {
          "name": "Danh Sách Người Dùng (Phân trang, Lọc, Tìm kiếm, Sắp xếp)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=0&size=10&role=CUSTOMER&q=nguyen&sort=createdAt,desc",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "0", "description": "Trang bắt đầu từ 0" },
                { "key": "size", "value": "10", "description": "Số bản ghi mỗi trang" },
                { "key": "role", "value": "CUSTOMER", "description": "Lọc: ALL, CUSTOMER, ROLE_DOCTOR, ROLE_STAFF, ROLE_ADMIN" },
                { "key": "q", "value": "nguyen", "description": "Tìm kiếm tên, email, sđt" },
                { "key": "sort", "value": "createdAt,desc", "description": "Sắp xếp theo trường" }
              ]
            }
          }
        },
